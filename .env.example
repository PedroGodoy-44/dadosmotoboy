# Copie para .env e preencha. O .env e gitignored — NUNCA versione tokens.
# Token em: Cloudflare Dashboard > My Profile > API Tokens (permissao "Cloudflare Pages: Edit").
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Nome do projeto no Cloudflare Pages (criado no 1o deploy se nao existir):
CF_PAGES_PROJECT=motoboys
