# Copie para .env e preencha. O .env e gitignored — NUNCA versione tokens.

# ── Alerta de falha de coleta (dead man's switch) ───────────────────────
# Sem isto, uma queda prolongada passa despercebida: em 01-02/08/2026 a coleta
# ficou 14h parada e ninguem soube (perdeu o turno de sabado a noite).
#
# Como obter: crie um check gratuito em https://healthchecks.io (sem cartao)
# e cole aqui a "Ping URL". Configure no painel deles:
#     Period = 3 minutos  (o intervalo de coleta)
#     Grace  = 15 minutos (tolera restart do systemd e blips de rede)
# O canal de aviso (e-mail, Telegram, WhatsApp...) se escolhe la, nao aqui.
HEALTHCHECK_URL=
# Ciclos seguidos com erro antes de sinalizar falha (5 x 3min = ~15 min):
ALERTA_FALHAS=5

# ── Cloudflare ─────────────────────────────────────────────────────────
# NAO usar em producao: o deploy e via `git push` puro (o CF publica no push)
# e o token do build fica no painel do Cloudflare, nao aqui. Preencher estas
# variaveis SOBRESCREVE o token do CI e quebra o deploy com auth error 10000.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CF_PAGES_PROJECT=motoboys
